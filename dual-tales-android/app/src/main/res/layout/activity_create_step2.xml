<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fitsSystemWindows="true">

    <!-- ======= Horizontal Guidelines ======= -->

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guide_toolbar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.054" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guide_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.142" />

    <!-- 질문+답변 카드: 170÷852 = 0.200 -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guide_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.200" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guide_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.810" />

    <!-- ======= Vertical Guidelines ======= -->

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guide_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.046" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guide_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.954" />

    <!-- ======= 상단 툴바 ======= -->
    <LinearLayout
        android:id="@+id/ll_toolbar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="@color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="12dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_back"
            android:scaleType="fitCenter"
            android:contentDescription="뒤로 가기" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="동화 만들기"
            android:textColor="#000000"
            android:fontFamily="@font/pretendard_bold"
            android:textSize="20sp"
            android:lineHeight="28sp"
            android:letterSpacing="-0.04"
            android:layout_marginStart="20dp" />

    </LinearLayout>

    <!-- ======= 스텝 인디케이터 (원 2 현재) ======= -->
    <LinearLayout
        android:id="@+id/ll_indicator"
        android:layout_width="wrap_content"
        android:layout_height="17dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/guide_indicator"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="19dp">

        <ImageView
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:src="@drawable/ic_step_inactive"
            android:contentDescription="@null"
            android:layout_marginTop="3dp" />

        <ImageView
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:src="@drawable/ic_step_active"
            android:contentDescription="@null"
            android:layout_marginStart="10dp" />

        <ImageView
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:src="@drawable/ic_step_inactive"
            android:contentDescription="@null"
            android:layout_marginStart="10dp"
            android:layout_marginTop="3dp" />

        <ImageView
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:src="@drawable/ic_step_inactive"
            android:contentDescription="@null"
            android:layout_marginStart="10dp"
            android:layout_marginTop="3dp" />

    </LinearLayout>

    <!-- ======= 콘텐츠 영역 (질문카드 + 답변카드) ======= -->
    <LinearLayout
        android:id="@+id/ll_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/guide_content"
        app:layout_constraintBottom_toTopOf="@id/ll_bottom"
        app:layout_constraintStart_toEndOf="@id/guide_left"
        app:layout_constraintEnd_toStartOf="@id/guide_right">

        <!-- 질문 카드 (질문 1 - 주인공) -->
        <LinearLayout
            android:id="@+id/ll_question"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_question_purple"
            android:paddingTop="10dp"
            android:paddingBottom="20dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:gravity="center">

            <TextView
                android:id="@+id/tv_question_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="질문 1"
                android:textColor="@color/main_purple"
                android:fontFamily="@font/pretendard_semibold"
                android:textSize="14sp"
                android:gravity="center" />

            <TextView
                android:id="@+id/tv_question_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="내 동화의 주인공은 누구인가요?"
                android:textColor="#151515"
                android:fontFamily="@font/pretendard_semibold"
                android:textSize="18sp"
                android:lineSpacingExtra="4sp"
                android:letterSpacing="-0.03"
                android:gravity="center"
                android:layout_marginTop="12dp" />

        </LinearLayout>

        <!-- 답변 카드 -->
        <LinearLayout
            android:id="@+id/ll_answer"
            android:layout_width="match_parent"
            android:layout_height="238dp"
            android:orientation="vertical"
            android:background="@drawable/bg_answer_card"
            android:padding="16dp"
            android:layout_marginTop="24dp">

            <EditText
                android:id="@+id/et_answer"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="답변을 입력해주세요."
                android:textColorHint="@color/gray06"
                android:fontFamily="@font/pretendard_medium"
                android:textSize="16sp"
                android:lineSpacingExtra="4sp"
                android:letterSpacing="-0.03"
                android:gravity="top"
                android:inputType="textMultiLine" />

            <LinearLayout
                android:id="@+id/btn_voice"
                android:layout_width="231dp"
                android:layout_height="37dp"
                android:orientation="horizontal"
                android:background="@drawable/bg_voice_button"
                android:gravity="center"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_gravity="center_horizontal"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="17dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_mic"
                    android:tint="#151515"
                    android:scaleType="fitCenter"
                    android:contentDescription="음성 입력" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="말로 내용 입력하기"
                    android:fontFamily="@font/pretendard_medium"
                    android:textSize="16sp"
                    android:lineSpacingExtra="4sp"
                    android:letterSpacing="-0.03"
                    android:textColor="#151515"
                    android:layout_marginStart="8dp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- ======= 하단 버튼 영역 ======= -->
    <LinearLayout
        android:id="@+id/ll_bottom"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/guide_bottom"
        app:layout_constraintStart_toEndOf="@id/guide_left"
        app:layout_constraintEnd_toStartOf="@id/guide_right">

        <TextView
            android:id="@+id/tv_temp_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="임시저장"
            android:gravity="center"
            android:textColor="#848484"
            android:fontFamily="@font/pretendard_medium"
            android:textSize="16sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_next"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="다음"
            android:background="@drawable/bg_button_black"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/pretendard_semibold"
            android:textSize="18sp"
            android:lineSpacingExtra="4sp"
            android:letterSpacing="-0.03"
            android:textAllCaps="false"
            android:stateListAnimator="@null"
            android:layout_marginTop="20dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
