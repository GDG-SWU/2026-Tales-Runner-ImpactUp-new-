<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/view_nav_divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/view_nav_divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#F5F5F5"
        app:layout_constraintBottom_toTopOf="@id/custom_bottom_nav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ======= 커스텀 하단 내비게이션 바 ======= -->
    <LinearLayout
        android:id="@+id/custom_bottom_nav"
        android:layout_width="0dp"
        android:layout_height="88dp"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 탭 1: 내 책장 -->
        <LinearLayout
            android:id="@+id/tab_bookshelf"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:contentDescription="내 책장">

            <LinearLayout
                android:id="@+id/tab_inner_bookshelf"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp">

                <ImageView
                    android:id="@+id/iv_tab_bookshelf"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_nav_bookshelf"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/tv_tab_bookshelf"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="내 책장"
                    android:textColor="#9E9E9E"
                    android:fontFamily="@font/pretendard_bold"
                    android:textSize="12sp"
                    android:letterSpacing="-0.05"
                    android:gravity="center"
                    android:layout_marginTop="3dp"
                    android:visibility="visible" />

            </LinearLayout>
        </LinearLayout>

        <!-- 탭 2: 만들기 -->
        <LinearLayout
            android:id="@+id/tab_create"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:contentDescription="만들기">

            <LinearLayout
                android:id="@+id/tab_inner_create"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp">

                <ImageView
                    android:id="@+id/iv_tab_create"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_nav_create"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/tv_tab_create"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="만들기"
                    android:textColor="#9E9E9E"
                    android:fontFamily="@font/pretendard_bold"
                    android:textSize="12sp"
                    android:letterSpacing="-0.05"
                    android:gravity="center"
                    android:layout_marginTop="3dp"
                    android:visibility="visible" />

            </LinearLayout>
        </LinearLayout>

        <!-- 탭 3: 검색 -->
        <LinearLayout
            android:id="@+id/tab_search"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:contentDescription="검색">

            <LinearLayout
                android:id="@+id/tab_inner_search"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp">

                <ImageView
                    android:id="@+id/iv_tab_search"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_nav_search"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/tv_tab_search"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="검색"
                    android:textColor="#9E9E9E"
                    android:fontFamily="@font/pretendard_bold"
                    android:textSize="12sp"
                    android:letterSpacing="-0.05"
                    android:gravity="center"
                    android:layout_marginTop="3dp"
                    android:visibility="visible" />

            </LinearLayout>
        </LinearLayout>

        <!-- 탭 4: 프로필 -->
        <LinearLayout
            android:id="@+id/tab_profile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:contentDescription="프로필">

            <LinearLayout
                android:id="@+id/tab_inner_profile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp">

                <ImageView
                    android:id="@+id/iv_tab_profile"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_nav_profile"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/tv_tab_profile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="프로필"
                    android:textColor="#9E9E9E"
                    android:fontFamily="@font/pretendard_bold"
                    android:textSize="12sp"
                    android:letterSpacing="-0.05"
                    android:gravity="center"
                    android:layout_marginTop="3dp"
                    android:visibility="visible" />

            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
