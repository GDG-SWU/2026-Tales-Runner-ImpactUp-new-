<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="323dp">

    <androidx.cardview.widget.CardView
        android:layout_width="307dp"
        android:layout_height="323dp"
        android:layout_gravity="center"
        app:cardCornerRadius="30dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@android:color/transparent">

        <!-- 책 커버 이미지 -->
        <ImageView
            android:id="@+id/iv_book_cover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:background="@android:color/transparent" />

        <!-- 하단 그라데이션 오버레이 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_gradient_bottom" />

        <!-- 페이지 배지 (좌상단) -->
        <TextView
            android:id="@+id/tv_page_badge"
            android:layout_width="76dp"
            android:layout_height="33dp"
            android:layout_gravity="top|start"
            android:background="@drawable/bg_page_badge_featured"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="4 / 16"
            android:fontFamily="@font/pretendard_bold"
            android:textSize="14sp"
            android:textColor="#C383E1"
            android:gravity="center" />

        <!-- 이어 읽기 버튼 (하단 중앙) -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_continue_reading"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_button_purple_round"
            android:text="이어 읽기"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/pretendard_bold"
            android:textSize="14sp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textAllCaps="false"
            android:stateListAnimator="@null" />

    </androidx.cardview.widget.CardView>

</FrameLayout>
