<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- ======= Horizontal Guidelines ======= -->

    <!-- 스텝 인디케이터: 87÷852 = 0.102 -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guide_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.07" />

    <!-- 본문 텍스트: 154÷852 = 0.181 -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guide_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.181" />

    <!-- 일러스트 이미지: 291÷852 = 0.342 -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guide_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.342" />

    <!-- 다음 버튼: 681÷852 = 0.799 -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guide_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.799" />

    <!-- ======= Vertical Guidelines ======= -->

    <!-- 왼쪽 여백: 18÷393 = 0.046 -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guide_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.046" />

    <!-- 오른쪽 여백: 375÷393 = 0.954 -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guide_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.954" />

    <!-- ======= 스텝 인디케이터 ======= -->
    <LinearLayout
        android:id="@+id/ll_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/guide_indicator"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="19dp">

        <!-- 원 1 (현재): 17×17dp -->
        <ImageView
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:src="@drawable/ic_step_active"
            android:contentDescription="@null" />

        <!-- 원 2 (미완료): 10×10dp, top margin 3dp으로 세로 가운데 정렬 -->
        <ImageView
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:src="@drawable/ic_step_inactive"
            android:contentDescription="@null"
            android:layout_marginStart="10dp"
            android:layout_marginTop="3dp" />

    </LinearLayout>

    <!-- ======= 본문 텍스트 ======= -->
    <TextView
        android:id="@+id/tv_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="듀얼테일즈는 AI기반 이중 언어동화를 제작해\n아이의 다문화 언어학습을 도와줍니다."
        android:textColor="#151515"
        android:fontFamily="@font/pretendard_semibold"
        android:textSize="20sp"
        android:lineSpacingExtra="8sp"
        android:letterSpacing="-0.05"
        app:layout_constraintTop_toBottomOf="@id/guide_text"
        app:layout_constraintStart_toEndOf="@id/guide_left"
        app:layout_constraintEnd_toStartOf="@id/guide_right" />

    <!-- ======= 일러스트 이미지 ======= -->
    <ImageView
        android:id="@+id/iv_onboarding"
        android:layout_width="270dp"
        android:layout_height="270dp"
        android:src="@drawable/img_onboarding1"
        android:scaleType="centerCrop"
        android:background="@drawable/bg_onboarding_image"
        android:clipToOutline="true"
        android:elevation="4dp"
        android:contentDescription="@null"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="291dp"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="62dp" />

    <!-- ======= 다음 버튼 ======= -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_next"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:text="다음"
        android:background="@drawable/bg_button_black"
        android:textColor="#FFFFFF"
        android:fontFamily="@font/pretendard_semibold"
        android:textSize="18sp"
        android:lineSpacingExtra="4sp"
        android:letterSpacing="-0.03"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textAllCaps="false"
        android:stateListAnimator="@null"
        app:layout_constraintTop_toBottomOf="@id/guide_button"
        app:layout_constraintStart_toEndOf="@id/guide_left"
        app:layout_constraintEnd_toStartOf="@id/guide_right" />

</androidx.constraintlayout.widget.ConstraintLayout>
