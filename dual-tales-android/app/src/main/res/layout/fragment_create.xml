<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- 1. 상단 툴바 -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_back"
            android:scaleType="fitCenter"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="동화 만들기"
            android:fontFamily="@font/pretendard_bold"
            android:textSize="20sp"
            android:textColor="#1A1A1A" />

    </LinearLayout>

    <!-- 2. 선택 카드 영역 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="175dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 카드 1: 한 질문으로 빠르게 만들기 -->
        <LinearLayout
            android:id="@+id/card_simple"
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:background="@drawable/bg_create_card"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pretendard_bold"
                android:letterSpacing="-0.05"
                android:lineSpacingExtra="8sp"
                android:text="한 질문만으로\n빠르게 만들기"
                android:textColor="#C383E1"
                android:textSize="20sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <ImageView
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center_vertical|end"
                android:src="@drawable/img_create_simple"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />

        </LinearLayout>

        <!-- 카드 2: 다양한 질문으로 대화하며 만들기 -->
        <LinearLayout
            android:id="@+id/card_detail"
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_create_card"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pretendard_bold"
                android:letterSpacing="-0.05"
                android:lineSpacingExtra="8sp"
                android:text="다양한 질문으로\n대화하며 만들기"
                android:textColor="#C383E1"
                android:textSize="20sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <ImageView
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center_vertical|end"
                android:src="@drawable/img_create_detail"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
